{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/wa-send-media.js": {
      "maxDuration": 60
    },
    "api/agenda-meet.js": {
      "maxDuration": 30
    },
    "api/wa-sync.js": {
      "maxDuration": 60
    },
    "api/wa-bitrix-digest.js": {
      "maxDuration": 60
    },
    "api/wa-send.js": {
      "maxDuration": 30
    },
    "api/bitrix-sync.js": {
      "maxDuration": 30
    },
    "api/gloria-responder.js": {
      "maxDuration": 30
    },
    "api/gloria-toques.js": {
      "maxDuration": 30
    },
    "api/gloria-agendar.js": {
      "maxDuration": 60
    },
    "api/agendar.js": {
      "maxDuration": 60
    },
    "api/gloria-abordar.js": {
      "maxDuration": 30
    },
    "api/lead-inbound.js": {
      "maxDuration": 60
    },
    "api/primeiro-contato.js": {
      "maxDuration": 60
    },
    "api/gloria-saude.js": {
      "maxDuration": 30
    },
    "api/gloria-transferir.js": {
      "maxDuration": 30
    },
    "api/lead-formulario.js": {
      "maxDuration": 20
    },
    "api/oportunidade-futura.js": {
      "maxDuration": 60
    },
    "api/wa-calls.js": {
      "maxDuration": 60
    },
    "api/wa-config.js": {
      "maxDuration": 60
    },
    "api/rel-wa.js": {
      "maxDuration": 60
    },
    "api/rel-viagens.js": {
      "maxDuration": 60
    },
    "api/rel-disparos.js": {
      "maxDuration": 60
    },
    "api/rel-docs.js": {
      "maxDuration": 30
    },
    "api/rel-recompra.js": {
      "maxDuration": 30
    },
    "api/rel-docs-ia.js": {
      "maxDuration": 60
    },
    "api/rel-viagem-ia.js": {
      "maxDuration": 60
    },
    "api/rel-bitrix-comentarios.js": {
      "maxDuration": 60
    },
    "api/rel-grupos.js": {
      "maxDuration": 60
    },
    "api/closer.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/wa-bitrix-digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/oportunidade-futura",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/rel-viagens",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/rel-viagens?arquivos=1",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/rel-disparos",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/rel-docs-ia",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/rel-viagem-ia",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/rel-bitrix-comentarios",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/rel-grupos?cron=1",
      "schedule": "7 */6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!agendar).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000"
        }
      ]
    },
    {
      "source": "/agendar(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://setuforeuvouviagens.com.br https://*.setuforeuvouviagens.com.br https://stfv-forms-geral.vercel.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/documentos/:token",
      "destination": "/index.html"
    },
    {
      "source": "/pesquisa/:token",
      "destination": "/index.html"
    },
    {
      "source": "/proposta/:token",
      "destination": "/index.html"
    }
  ]
}
