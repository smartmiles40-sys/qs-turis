{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agenda-meet.js": {
      "maxDuration": 30
    },
    "api/wa-send.js": {
      "maxDuration": 30
    },
    "api/bitrix-sync.js": {
      "maxDuration": 30
    },
    "api/gloria-responder.js": {
      "maxDuration": 30
    },
    "api/gloria-toques.js": {
      "maxDuration": 30
    },
    "api/gloria-abordar.js": {
      "maxDuration": 30
    },
    "api/gloria-saude.js": {
      "maxDuration": 30
    },
    "api/gloria-transferir.js": {
      "maxDuration": 30
    },
    "api/lead-formulario.js": {
      "maxDuration": 20
    },
    "api/rel-docs.js": {
      "maxDuration": 30
    },
    "api/rel-recompra.js": {
      "maxDuration": 30
    },
    "api/rel-grupos.js": {
      "maxDuration": 120
    },
    "api/closer.js": {
      "maxDuration": 60,
      "includeFiles": "api/_contrato_assets/**"
    },
    "api/assistente.js": {
      "maxDuration": 30
    },
    "api/mkt-grupos-link.js": {
      "maxDuration": 10
    },
    "api/qs-alertas.js": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/wa-bitrix-digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/oportunidade-futura",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/rel-viagens",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/rel-viagens?arquivos=1",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/rel-disparos",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/disparos",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/disparos?mkt=1",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/rel-docs-ia",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/rel-viagem-ia",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/rel-bitrix-comentarios",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/rel-grupos?cron=1",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/expedicoes?acao=atualizar-status",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/expedicoes?acao=espelho",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/expedicoes?acao=sincronizar-todas",
      "schedule": "0,15,30 12 * * *"
    },
    {
      "path": "/api/avisos",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/agenda-reparo",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/bitrix-catalogo",
      "schedule": "10 9 * * *"
    },
    {
      "path": "/api/closer?acao=cron-bitrix",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/leads-sem-card?acao=retentar",
      "schedule": "4-59/10 * * * *"
    },
    {
      "path": "/api/rel-vendas",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/mkt-drive?cron=1",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/mkt-grupos",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mkt-email",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/mkt-automacoes?cron=1",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/dashboard-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/meet-gravacoes",
      "schedule": "7-59/15 * * * *"
    },
    {
      "path": "/api/fin-comissoes",
      "schedule": "11,41 * * * *"
    },
    {
      "path": "/api/qs-alertas",
      "schedule": "*/15 11-22 * * 1-6"
    },
    {
      "path": "/api/cadencia-sweep",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/mkt-trafego?cron=1",
      "schedule": "7,37 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index\\.html|version\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(documentos|pesquisa|proposta)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!agendar).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000"
        }
      ]
    },
    {
      "source": "/agendar(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://setuforeuvouviagens.com.br https://*.setuforeuvouviagens.com.br https://stfv-forms-geral.vercel.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/g/:slug",
      "destination": "/api/mkt-grupos-link?slug=:slug"
    },
    {
      "source": "/e/:codigo",
      "destination": "/api/mkt-automacoes?e=:codigo"
    },
    {
      "source": "/documentos/:token",
      "destination": "/index.html"
    },
    {
      "source": "/pesquisa/:token",
      "destination": "/index.html"
    },
    {
      "source": "/proposta/:token",
      "destination": "/index.html"
    }
  ]
}
