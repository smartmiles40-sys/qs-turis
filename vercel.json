{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/wa-send-media.js": {
      "maxDuration": 60
    },
    "api/wa-webhook.js": {
      "maxDuration": 30
    },
    "api/wa-vigia.js": {
      "maxDuration": 30
    },
    "api/wa-history.js": {
      "maxDuration": 60
    },
    "api/agenda-meet.js": {
      "maxDuration": 30
    },
    "api/wa-sync.js": {
      "maxDuration": 60
    },
    "api/wa-bitrix-digest.js": {
      "maxDuration": 60
    },
    "api/wa-send.js": {
      "maxDuration": 30
    },
    "api/bitrix-sync.js": {
      "maxDuration": 30
    },
    "api/gloria-responder.js": {
      "maxDuration": 30
    },
    "api/gloria-toques.js": {
      "maxDuration": 30
    },
    "api/gloria-agendar.js": {
      "maxDuration": 60
    },
    "api/gloria-transferir.js": {
      "maxDuration": 30
    },
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/wa-bitrix-digest",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=15552000"
        }
      ]
    }
  ]
}
