# Copie este arquivo para .env e preencha com os dados do SEU projeto Supabase.
# (.env NÃO vai para o git.)  Painel: Supabase > Project Settings > API.

# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" / publishable (NÃO use a service_role no front!)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE (sem prefixo VITE_ -> NÃO vai pro navegador). Usado pelas funções
# em /api (webhook de leads, gestão de usuários). Veja docs/INTEGRACOES.md.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_INBOUND_SECRET=

# ---------------------------------------------------------------------------
# Sincronização QS -> Bitrix por WEBHOOK (na hora que o SDR age).
# DESDE 2026-07-13 o navegador NÃO fala mais com o n8n direto: o front chama a
# rota /api/bitrix-sync (autenticada pelo login do SDR) e ELA encaminha pro n8n
# com um segredo. Por isso as variáveis são SERVER-SIDE (sem VITE_ — não vão
# pro bundle):
#   N8N_SYNC_BASE   = base dos webhooks do n8n, SEM barra final
#                     (ex.: https://SEU-N8N.hostinger.com/webhook)
#   N8N_SYNC_SECRET = valor do header x-qs-sync-secret que o n8n valida
#                     (crie a credencial Header Auth no n8n com o MESMO valor)
# Vazio = integração desligada (nada quebra; só não espelha no Bitrix).
# Importe o workflow n8n/qs-to-bitrix-webhook.workflow.json — veja n8n/README.md.
# (VITE_N8N_SYNC_BASE ficou OBSOLETA — pode remover da Vercel se tiver setado.)
# ---------------------------------------------------------------------------
N8N_SYNC_BASE=
N8N_SYNC_SECRET=

# ---------------------------------------------------------------------------
# AGENDA: Google Meet automático no "Ganho / Agendou".
# Ao confirmar o ganho, o QS pede ao n8n que crie o evento no Google Calendar
# com sala do Meet e convide o closer e o cliente. O link volta e é gravado na
# reunião (qs_meetings.meeting_link + calendar_event_id).
#   N8N_AGENDA_URL    = URL COMPLETA do webhook de produção (termina em
#                       /webhook/qs-agenda-meet — a de /webhook-test/ morre
#                       depois de uma execução)
#   N8N_AGENDA_SECRET = valor do header x-qs-agenda-secret que o n8n valida
#                       (credencial Header Auth no n8n com o MESMO valor)
# Vazio = desligado: o Ganho funciona igual, só sem criar o evento (a rota
# responde 501 e o front segue em silêncio).
# Importe n8n/agenda-google-meet.workflow.json e aplique a migration
# supabase/migrations/0031_agenda_google_meet.sql.
# ---------------------------------------------------------------------------
N8N_AGENDA_URL=
N8N_AGENDA_SECRET=

# ---------------------------------------------------------------------------
# WHATSAPP — Cloud API da Meta (número oficial). ÚNICO caminho desde 23/09/2026:
# Chatwoot e Evolution saíram do QS. Tudo SERVER-SIDE (nunca no navegador).
# Passo a passo em docs/WHATSAPP-META.md.
#
#   META_CALLS_TOKEN        token PERMANENTE de usuário de sistema do app
#                           (aceita META_WA_TOKEN como nome alternativo)
#   META_PHONE_NUMBER_ID    id do número oficial na Meta
#   META_WABA_ID            OPCIONAL: id da conta do WhatsApp Business. Sem ele o
#                           QS descobre sozinho pelo token (debug_token).
#   META_CALLS_APP_SECRET   app secret — confere a assinatura de todo webhook
#   META_CALLS_VERIFY_TOKEN a frase que a Meta devolve ao cadastrar o webhook
#   META_CALLS_APP_ID       id do app (diagnóstico de assinaturas)
# ---------------------------------------------------------------------------
META_CALLS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_CALLS_APP_SECRET=
META_CALLS_VERIFY_TOKEN=
META_CALLS_APP_ID=

# ---------------------------------------------------------------------------
# GLÓRIA — atendimento de IA no WhatsApp (n8n)
#
# A IA mora no n8n (n8n/gloria-atendimento.workflow.json) e fala com o lead
# ATRAVÉS do QS: a entrada da Meta avisa o n8n que chegou mensagem (só com
# qs_settings.gloria_ouve_meta = true), o n8n
# pensa e devolve os balões em /api/gloria-responder, que envia pelo número
# oficial e grava na conversa do lead.
#
#   GLORIA_WEBHOOK_URL = URL de PRODUÇÃO do webhook do n8n (termina em
#                        /webhook/gloria-atendimento — a de /webhook-test/
#                        morre depois de uma execução)
#   GLORIA_SECRET      = o mesmo valor nos dois lados: o QS manda no header
#                        x-gloria-secret, e o n8n valida com uma credencial
#                        Header Auth de mesmo nome. As rotas /api/gloria-* do
#                        QS exigem esse header também.
#
# Vazio = desligado: o WhatsApp funciona igual, só sem IA nenhuma.
# Antes de ligar: aplicar supabase/migrations/0053_gloria_ia.sql e depois
#   update qs_settings set value = 'true'::jsonb where key = 'gloria_ativa';
# ---------------------------------------------------------------------------
GLORIA_WEBHOOK_URL=
GLORIA_SECRET=

# ---------------------------------------------------------------------------
# RODÍZIO DAS LANDING PAGES — número de emergência
#
# Este é o ÚNICO número de WhatsApp que mora em variável de ambiente. Todos os
# outros ficam na tabela sdr_pool, justamente pra trocar chip não exigir deploy
# (ver supabase/migrations/0076_pool_de_numeros.sql e a tela
# Configurações → Números do WhatsApp).
#
# Ele é usado só quando /api/lead não consegue decidir: banco fora do ar, ou
# nenhum SDR ativo com número ativo. Serve pra ninguém que preencheu um
# formulário ficar sem destino — lead pago não tem desfazer.
#
# SÓ DÍGITOS, com DDI: 5511999999999
# ---------------------------------------------------------------------------
WHATSAPP_FALLBACK=
