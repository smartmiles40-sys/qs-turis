        "assignments": {
          "assignments": [
            {
              "id": "pc-cfg-base-0001",
              "name": "BITRIX_BASE",
              "type": "string",
              "value": "PREENCHA_BITRIX_WEBHOOK_BASE"
            },
            {
              "id": "pc-cfg-de-0002",
              "name": "STAGE_DE",
              "type": "string",
              "value": "C25:PREPAYMENT_INVOIC"
            },
            {
              "id": "pc-cfg-para-0003",
              "name": "STAGE_PARA",
              "type": "string",
              "value": "C25:UC_271QUB"
            },
            {
              "id": "pc-cfg-alc-0004",
