    {
      "parameters": {
        "jsCode": "// O crm.deal.update acima segue em frente mesmo com erro (onError:\n// continueRegularOutput) E o Bitrix responde HTTP 200 com {\"error\":...} quando\n// recusa — as duas coisas juntas faziam a execucao ficar VERDE com o card\n// parado. Sem este throw, o unico sintoma e \"agendar reuniao no QS e o negocio nao\n// anda no Bitrix\", sem nenhuma pista de onde olhar.\nconst r = $input.first().json;\nif (!r || r.error) {\n  throw new Error(\"Bitrix recusou agendar reuniao: \" + ((r && (r.error_description || r.error)) || \"resposta vazia\"));\n}\n// result === false tambem e recusa: o Bitrix devolve 200 sem mover nada.\nif (r.result === false) {\n  throw new Error(\"Bitrix nao moveu o negocio (agendar reuniao): result=false\");\n}\nreturn $input.all();"
      },
