      "id": "cfg-pc-0015-4a10-9b01-0d2e3f4a5c15",
      "name": "Config 1o contato",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        940
      ],
      "notes": "EDITE SO ESTE NO desta faixa. BITRIX_BASE = webhook de ENTRADA, sem barra no fim, e PRECISA ter o escopo CRM (confira em BASE/scope.json: [\"\"] = sem permissao, nada funciona). STAGE_DE = coluna Novo lead. STAGE_PARA = coluna Follow-up 1 — os DOIS iguais aos do workflow bitrix-atividade-concluida. SO_ALCANCOU = nao (qualquer atividade concluida move) ou sim (so quando o SDR falou mesmo com a pessoa).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config 1o contato').first().json.BITRIX_BASE }}/crm.deal.get.json?id={{ $('Webhook 1o contato (qs-primeiro-contato)').first().json.body.bitrix_id }}",
        "options": {}
      },
      "id": "get-pc-0016-4a10-9b01-0d2e3f4a5c16",
      "name": "Buscar negocio (1o contato)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        940
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// AQUI mora o \"primeiro contato\": nao existe contador nem flag — a regra e\n// \"so move quem AINDA esta em Novo lead\". Da 2a atividade em diante o negocio ja\n// saiu dessa coluna, entao o evento chega, olha e nao faz nada. De quebra, isso\n// impede o robo de puxar PRA TRAS um negocio que ja avancou (Reuniao Agendada,\n// Ganho, Perdido) e torna o disparo idempotente: repetir nao estraga nada.\nconst cfg = $('Config 1o contato').first().json;\nconst evt = $('Webhook 1o contato (qs-primeiro-contato)').first().json.body || {};\nconst resp = $input.first().json;\n\n// O crm.deal.get acima segue em frente mesmo com erro (onError). Se o Bitrix\n// RECUSOU, isso tem que ficar VERMELHO: sem este throw o unico sintoma e \"o\n// negocio nao anda\" e a execucao aparece verde. Erro classico:\n// insufficient_scope = o webhook de ENTRADA foi criado sem a permissao CRM.\nif (resp && resp.error) {\n  throw new Error('Bitrix recusou o crm.deal.get: ' + resp.error + ' — ' + (resp.error_description || ''));\n}\n\nconst r = resp.result;\nif (!r) return [];   // negocio nao encontrado no Bitrix\n\n// Opcional: mover so quando o SDR REALMENTE falou com a pessoa.\n// SO_ALCANCOU = \"sim\" liga o filtro; \"nao\" (padrao) move em qualquer atividade\n// concluida — mesmo criterio do workflow gemeo do lado do Bitrix, pra mesma acao\n// dar o mesmo resultado sendo registrada no QS ou no CRM.\nif (String(cfg.SO_ALCANCOU || '').toLowerCase() === 'sim' && evt.alcancou !== true) return [];\n\nif (String(r.STAGE_ID || '') !== String(cfg.STAGE_DE)) return [];\n\nreturn [{ json: {\n  id: String(r.ID),\n  de: String(r.STAGE_ID || ''),\n  para: String(cfg.STAGE_PARA),\n  canal: String(evt.canal || ''),\n  desfecho: String(evt.desfecho || ''),\n  sdr: String(evt.sdr || '')\n} }];"
      },
      "id": "flt-pc-0017-4a10-9b01-0d2e3f4a5c17",
      "name": "So se ainda estiver em Novo lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        940
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config 1o contato').first().json.BITRIX_BASE }}/crm.deal.update.json",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.id, fields: { STAGE_ID: $json.para }, params: { REGISTER_SONET_EVENT: 'Y' } }) }}",
        "options": {}
      },
      "id": "upd-pc-0018-4a10-9b01-0d2e3f4a5c18",
      "name": "Mover pra Follow-up 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        940
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config 1o contato').first().json.BITRIX_BASE }}/crm.timeline.comment.add.json",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { ENTITY_ID: $('So se ainda estiver em Novo lead').first().json.id, ENTITY_TYPE: 'deal', COMMENT: '🤖 1º CONTATO FEITO (QS Turis) — negócio movido de Novo lead para Follow-up 1.\\n' + 'Canal: ' + ($('So se ainda estiver em Novo lead').first().json.canal || '-') + '\\n' + 'Desfecho: ' + ($('So se ainda estiver em Novo lead').first().json.desfecho || '-') + '\\n' + 'SDR: ' + ($('So se ainda estiver em Novo lead').first().json.sdr || '-') } }) }}",
        "options": {}
      },
      "id": "cmt-pc-0019-4a10-9b01-0d2e3f4a5c19",
      "name": "Comentario do 1o contato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        940
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// O crm.deal.update acima segue em frente mesmo com erro (onError:\n// continueRegularOutput) E o Bitrix responde HTTP 200 com {\"error\":...} quando\n// recusa — as duas coisas juntas faziam a execucao ficar VERDE com o card\n// parado. Sem este throw, o unico sintoma e \"marcar perdido no QS e o negocio nao\n// anda no Bitrix\", sem nenhuma pista de onde olhar.\nconst r = $input.first().json;\nif (!r || r.error) {\n  throw new Error(\"Bitrix recusou marcar perdido: \" + ((r && (r.error_description || r.error)) || \"resposta vazia\"));\n}\n// result === false tambem e recusa: o Bitrix devolve 200 sem mover nada.\nif (r.result === false) {\n  throw new Error(\"Bitrix nao moveu o negocio (marcar perdido): result=false\");\n}\nreturn $input.all();"
      },
      "id": "guard-mover-pra-perdido",
      "name": "Conferir movimentacao (perdido)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// O crm.deal.update acima segue em frente mesmo com erro (onError:\n// continueRegularOutput) E o Bitrix responde HTTP 200 com {\"error\":...} quando\n// recusa — as duas coisas juntas faziam a execucao ficar VERDE com o card\n// parado. Sem este throw, o unico sintoma e \"marcar ganho no QS e o negocio nao\n// anda no Bitrix\", sem nenhuma pista de onde olhar.\nconst r = $input.first().json;\nif (!r || r.error) {\n  throw new Error(\"Bitrix recusou marcar ganho: \" + ((r && (r.error_description || r.error)) || \"resposta vazia\"));\n}\n// result === false tambem e recusa: o Bitrix devolve 200 sem mover nada.\nif (r.result === false) {\n  throw new Error(\"Bitrix nao moveu o negocio (marcar ganho): result=false\");\n}\nreturn $input.all();"
      },
      "id": "guard-mover-pra-ganho",
      "name": "Conferir movimentacao (ganho)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
