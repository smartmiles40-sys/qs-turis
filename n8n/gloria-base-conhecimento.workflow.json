    {
      "parameters": {
        "jsCode": "// O que a Glória sabe depois desta carga.\nconst fichas = $('Trazer as fichas de volta').all().map((i) => i.json);\nconst paginas = [...new Set(fichas.map((f) => f.slug))];\n\nreturn [{ json: {\n  fichas_carregadas: fichas.length,\n  paginas: paginas.length,\n  quais: paginas.join(\", \"),\n  quando: $now.toISO(),\n  confira: \"select metadata->>'slug' pagina, count(*) pedacos from gloria_documents group by 1 order by 1;\",\n} }];"
      },
      "id": "base-0013-4000-8000-000000000013",
      "name": "Resumo da carga",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
