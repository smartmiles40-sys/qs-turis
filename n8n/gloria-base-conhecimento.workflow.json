        2208
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.SUPABASE_URL }}/rest/v1/gloria_fontes?ativo=eq.true&select=id,slug,secao,titulo,url,conteudo&order=slug.asc,secao.asc",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
      "id": "b0f0c2d4-0001-4a11-9f00-gloria-fichas",
      "name": "Fichas (gloria_fontes)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2304,
        2208
