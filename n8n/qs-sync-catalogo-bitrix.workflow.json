        "url": "={{ $('Config').first().json.BITRIX_BASE }}/crm.deal.fields.json",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "id": "a1000000-0000-4000-8000-00000000000a",
      "name": "Bitrix deal.fields (rótulos)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        90,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notesInFlow": true,
      "notes": "userfield.list traz os campos e as opções, mas NÃO o rótulo neste portal. O rótulo vem daqui, em formLabel/listLabel."
    }
