              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Cron diário 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qs-sync-catalogo",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Webhook sync manual",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -460,
        200
      ],
      "webhookId": "a1000000-0000-4000-8000-0000000000ff",
      "notes": "Para rodar na hora depois de criar um campo ou um closer novo no Bitrix.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUBSTITUA",
          "name": "QS Sync (x-qs-sync-secret)"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "BITRIX_BASE",
              "value": "https://SEUPORTAL.bitrix24.com.br/rest/23/SEU_TOKEN_DE_ENTRADA",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "SUPABASE_URL",
              "value": "https://eabfjomrnucymduqnbci.supabase.co",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -240,
        100
      ],
      "notes": "O BITRIX_BASE contém o token do webhook de entrada. Preencha SÓ aqui no n8n — nunca no arquivo, que fica num repositório público."
    },
    {
      "parameters": {
        "url": "={{ $json.BITRIX_BASE }}/crm.deal.userfield.list.json",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Bitrix userfield.list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Sem filtro: crm.deal.userfield.list já devolve só os campos de negócio. O filter[ENTITY_ID] pertence a outro método e alguns portais recusam."
    },
    {
      "parameters": {
        "jsCode": "const res = $('Bitrix userfield.list').first().json;\nconst fieldsResp = $input.first().json;\n\nif (res && res.error) {\n  throw new Error('Bitrix recusou o userfield.list: ' + res.error + ' | ' + (res.error_description || '') +\n    ' — quase sempre e o BITRIX_BASE errado (placeholder?) ou o webhook sem escopo crm.');\n}\nif (fieldsResp && fieldsResp.error) {\n  throw new Error('Bitrix recusou o deal.fields: ' + fieldsResp.error + ' | ' + (fieldsResp.error_description || ''));\n}\n\nconst lista = (res && res.result) || [];\nif (!Array.isArray(lista) || !lista.length) {\n  // Diz o que REALMENTE chegou, em vez de mandar conferir escopo no escuro.\n  const amostra = typeof res === 'string' ? res.slice(0, 200) : JSON.stringify(res || {}).slice(0, 200);\n  throw new Error('userfield.list voltou sem campos. O que chegou: ' + amostra);\n}\n\n// Rotulos, do crm.deal.fields: formLabel/listLabel. O 'title' repete o nome tecnico.\nconst rotulos = {};\nconst dic = (fieldsResp && fieldsResp.result) || {};\nfor (const k of Object.keys(dic)) {\n  const d = dic[k] || {};\n  const r = d.formLabel || d.listLabel || d.title || '';\n  if (r && r !== k) rotulos[k] = String(r);\n}\n\nconst runTs = new Date().toISOString();\nconst campos = [];\nconst opcoes = [];\n\nfor (const f of lista) {\n  let label = rotulos[f.FIELD_NAME];\n  if (!label) {\n    label = f.EDIT_FORM_LABEL || f.LIST_COLUMN_LABEL || f.FIELD_NAME;\n    if (label && typeof label === 'object') {\n      label = label.br || label.pt || label.en || Object.values(label)[0] || f.FIELD_NAME;\n    }\n  }\n\n  campos.push({\n    field_name: f.FIELD_NAME,\n    user_type_id: f.USER_TYPE_ID,\n    label: String(label || f.FIELD_NAME),\n    mandatory: f.MANDATORY === 'Y',\n    synced_at: runTs\n  });\n\n  for (const item of (f.LIST || [])) {\n    opcoes.push({\n      field_name: f.FIELD_NAME,\n      option_id: Number(item.ID),\n      value: item.VALUE,\n      sort: Number(item.SORT) || 500,\n      active: true,\n      synced_at: runTs\n    });\n  }\n}\n\nconst semRotulo = campos.filter(function (c) { return c.label === c.field_name; }).length;\n\nreturn [{ json: {\n  run_ts: runTs,\n  campos,\n  opcoes,\n  total_campos: campos.length,\n  total_opcoes: opcoes.length,\n  sem_rotulo: semRotulo,\n  aviso: semRotulo ? (semRotulo + ' campos ficaram sem rotulo legivel') : null\n} }];"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Montar payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.SUPABASE_URL }}/rest/v1/bitrix_fields?on_conflict=field_name",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.campos) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Upsert campos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "merge-duplicates preserva a coluna alias, que é preenchida à mão e nunca vem do Bitrix.",
      "credentials": {
        "supabaseApi": {
          "id": "SUBSTITUA",
          "name": "Supabase QS (service_role)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.SUPABASE_URL }}/rest/v1/bitrix_field_options?on_conflict=field_name,option_id",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($('Montar payloads').first().json.opcoes) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Upsert opções",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "supabaseApi": {
          "id": "SUBSTITUA",
          "name": "Supabase QS (service_role)"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.SUPABASE_URL }}/rest/v1/bitrix_field_options?synced_at=lt.{{ encodeURIComponent($('Montar payloads').first().json.run_ts) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
