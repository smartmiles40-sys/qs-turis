@@ -0,0 +1,60 @@
+/**
+ * Masters do portal (ExpedAmigo /amigo e Área do Líder /lider) — lidos do BANCO
+ * quando o banco tiver a configuração; senão, a lista fixa do código.
+ *
+ * Por quê (06/11/2026): no QS a lista virou uma tabela editável
+ * (`exp_acesso_masters`, migration 0319 do QS) com a função `exp_masters_portal(p_area)`
+ * (só service role). Este app passa a ler essa função QUANDO ELA EXISTE.
+ *
+ * Enquanto este app aponta pro banco ANTIGO (bnbpsuenlokhljrkvlke) a função NÃO
+ * existe lá → a chamada falha → vale a lista fixa do código, exatamente como hoje.
+ * Nada muda até a virada do portal pro banco do QS. Depois da virada, quem adicionar
+ * ou tirar um master na tela do QS (Acessos ExpedAmigo → Masters) já vale aqui, sem
+ * commit.
+ *
+ * Regra de segurança: se a função existir mas devolver lista VAZIA (tabela vazia ou
+ * todos desativados), também cai na lista fixa — ninguém perde o acesso por engano.
+ * Cache de 60 s por instância (o login não paga uma ida ao banco a cada tentativa).
+ */
+import "server-only";
+import type { createServiceRoleClient } from "@/lib/supabase/admin";
+
+type Sb = ReturnType<typeof createServiceRoleClient>;
+export type AreaMaster = "portal" | "lider";
+
+const CACHE_MS = 60_000;
+const cache = new Map<AreaMaster, { em: number; mapa: Record<string, string> }>();
+
+/** Converte as linhas da função num mapa CPF (11 dígitos) → nome. Linha inválida é ignorada. */
+export function mapaDeLinhas(linhas: unknown): Record<string, string> {
+  const mapa: Record<string, string> = {};
+  if (!Array.isArray(linhas)) return mapa;
+  for (const l of linhas as { cpf?: unknown; nome?: unknown }[]) {
+    const cpf = String(l?.cpf ?? "").replace(/\D/g, "");
+    const nome = String(l?.nome ?? "").trim();
+    if (cpf.length === 11 && nome) mapa[cpf] = nome;
+  }
+  return mapa;
+}
+
+export async function mastersDoPortal(
+  sb: Sb | null,
+  area: AreaMaster,
+  fixos: Record<string, string>,
+): Promise<Record<string, string>> {
+  if (!sb) return fixos;
+  const c = cache.get(area);
+  if (c && Date.now() - c.em < CACHE_MS) return c.mapa;
+  let mapa = fixos;
+  try {
+    const { data, error } = await sb.rpc("exp_masters_portal", { p_area: area });
+    if (!error) {
+      const doBanco = mapaDeLinhas(data);
+      if (Object.keys(doBanco).length > 0) mapa = doBanco;
+    }
+  } catch {
+    // banco antigo (sem a função) ou falha de rede: lista fixa
+  }
+  cache.set(area, { em: Date.now(), mapa });
+  return mapa;
+}
